# Copy to .env.production and replace every placeholder.
# Do not commit .env.production.
#
# Required for production Compose / Caddy / the application:
#   AKRASIA_DOMAIN
#   POSTGRES_USER
#   POSTGRES_PASSWORD
#   POSTGRES_DB
#   AKRASIA_PASSWORD_HASH
#   AKRASIA_ANALYSIS_API_TOKEN
#
# AKRASIA_COOKIE_SECURE is forced true by docker-compose.prod.yml.
# The web container receives POSTGRES_* and builds DATABASE_URL
# with percent-encoding, so the password does not need to be
# URL-safe. Avoid `$` in the password; Compose may interpolate it.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Optional (not required to run the HTML UI or analysis API):
#   APP_NAME, DISPLAY_NAME, APP_TIMEZONE
#   FOCUS_SESSION_MINUTES, BREAK_DURATION_MINUTES, LOG_LEVEL
#   EVAL_AGENT_*  — evaluation harness only; omit on the VPS
#
# Point an A/AAAA record at the VPS before certificate issuance.
# Do not use a real domain in this example file.

AKRASIA_DOMAIN=replace.example.com

POSTGRES_USER=akrasia
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=akrasia

AKRASIA_PASSWORD_HASH=replace-with-an-argon2id-password-hash
AKRASIA_ANALYSIS_API_TOKEN=replace-with-a-long-random-secret

APP_NAME=Akrasia_Zero
DISPLAY_NAME=Matt Stone
APP_TIMEZONE=Europe/London
FOCUS_SESSION_MINUTES=25
BREAK_DURATION_MINUTES=5
LOG_LEVEL=INFO
