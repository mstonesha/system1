# Safe local placeholders. Docker Compose supplies these explicitly
# for the web and test services. Do not commit a real .env file.

APP_NAME=Akrasia_Zero
DISPLAY_NAME=Matt Stone
APP_TIMEZONE=Europe/London
FOCUS_SESSION_MINUTES=25
BREAK_DURATION_MINUTES=5
LOG_LEVEL=INFO

# Required wherever the application needs a database.
# Do not rely on an implicit production default.
DATABASE_URL=postgresql+psycopg://system1:system1@localhost:5432/system1

# Machine bearer token for /api/analysis/*. Required for those
# JSON routes. Leave unset and those routes fail closed (401).
# The HTML UI does not use this token. Generate a strong value:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AKRASIA_ANALYSIS_API_TOKEN=replace-with-a-long-random-secret

# Evaluation-harness model (optional). Live agent evaluation only.
# Leave unset for dry-run and automated tests. Never commit a real key.
EVAL_AGENT_BASE_URL=https://api.openai.com/v1
EVAL_AGENT_MODEL=gpt-5.6-sol
EVAL_AGENT_API_KEY=replace-with-your-eval-agent-api-key
